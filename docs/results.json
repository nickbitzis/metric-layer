 "naive": [
  {
   "name": "Net revenue, all time",
   "why": "orders JOIN order_items JOIN refunds: each refund repeats once per line item, each item once per refund",
   "naive": 2414666.27,
   "correct": 2486970.3,
   "error_pct": -2.91,
   "naive_sql": "SELECT SUM(oi.quantity * oi.unit_price - oi.discount_amount) - SUM(COALESCE(r.amount, 0))\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.order_id\nLEFT JOIN refunds r ON r.order_id = o.order_id\nWHERE o.status <> 'cancelled'"
  },
  {
   "name": "Refunds issued, all time",
   "why": "same join, refund side only: a refund on a 4-item order is counted 4 times",
   "naive": 212237.31,
   "correct": 78632.28,
   "error_pct": 169.91,
   "naive_sql": "SELECT SUM(r.amount)\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.order_id\nJOIN refunds r ON r.order_id = o.order_id"
  },
  {
   "name": "Average order value",
   "why": "AVG over joined item rows averages line items, not orders",
   "naive": 64.02801547292239,
   "correct": 136.35217793367346,
   "error_pct": -53.04,
   "naive_sql": "SELECT AVG(oi.quantity * oi.unit_price - oi.discount_amount)\nFROM orders o JOIN order_items oi ON oi.order_id = o.order_id\nWHERE o.status <> 'cancelled'"
  },
  {
   "name": "Sessions, all time",
   "why": "INNER JOIN to customers to get country drops anonymous sessions (customer_id is NULL)",
   "naive": 67956.0,
   "correct": 100000.0,
   "error_pct": -32.04,
   "naive_sql": "SELECT COUNT(*) FROM sessions s JOIN customers c ON c.customer_id = s.customer_id"
  },
  {
   "name": "Conversion rate",
   "why": "average of per-customer conversion rates (an average of ratios) that also skips anonymous sessions",
   "naive": 0.27631733490444826,
   "correct": 0.2,
   "error_pct": 38.16,
   "naive_sql": "SELECT AVG(rate) FROM (\n  SELECT customer_id, AVG(CASE WHEN converted THEN 1.0 ELSE 0 END) AS rate\n  FROM sessions WHERE customer_id IS NOT NULL GROUP BY 1)"
  }
 ],
